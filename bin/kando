#!/bin/bash
# F13 нет в дефолтной раскладке — мапим (нужно для хоткея Kando; переживает ребут через этот же wrapper)
xmodmap -e 'keycode 191 = F13' 2>/dev/null
# Kando AppImage + свежий libstdc++ (conda-forge): в Ubuntu 22.04 нет GLIBCXX_3.4.32
export LD_PRELOAD="$HOME/lib/conda/lib/libstdc++.so.6.0.36${LD_PRELOAD:+:$LD_PRELOAD}"
exec "$HOME/Applications/Kando-3.0.1-x86_64.AppImage" "$@"
