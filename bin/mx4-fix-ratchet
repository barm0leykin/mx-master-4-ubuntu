#!/bin/bash
# MX Master 4: режим трещотки (mode в фиче SMART SHIFT ENHANCED) хранится в мыши
# и сбрасывается при её сне. Solaar пере-применяет настройки только при
# реконнекте. Скрипт проверяет режим и возвращает целевой, если слетел.
# Запускается таймером systemd --user (mx4-ratchet.timer).
export DISPLAY=:0
export XAUTHORITY="$HOME/.Xauthority"
SOLAAR="$HOME/.local/bin/solaar"
TARGET="Вращение с храповым механизмом"

CUR=$(timeout 10 "$SOLAAR" config "MX Master 4" scroll-ratchet 2>/dev/null | tail -1)
if [ -z "$CUR" ]; then
    echo "$(date '+%F %T'): мышь недоступна (сон/выключена) — пропуск"
    exit 0
fi
if echo "$CUR" | grep -q "храповым"; then
    exit 0  # режим на месте, ничего не пишем (лишний радио-трафик не шлём)
fi
if timeout 10 "$SOLAAR" config "MX Master 4" scroll-ratchet "$TARGET" >/dev/null 2>&1; then
    echo "$(date '+%F %T'): трещотка слетела — восстановлена"
else
    echo "$(date '+%F %T'): записать не удалось"
fi

# средний клик: действие слетает при сбоях мыши и перезаписывается GUI Solaar —
# возвращаем "Mouse Middle Button", если отклонилось
ACT=$(timeout 10 "$HOME/.local/bin/solaar" config "MX Master 4" reprogrammable-keys 2>/dev/null | tail -1)
if [ -n "$ACT" ] && ! echo "$ACT" | grep -q "Middle Button:Mouse Middle Button"; then
    timeout 10 "$HOME/.local/bin/solaar" config "MX Master 4" reprogrammable-keys "Middle Button" "Mouse Middle Button" >/dev/null 2>&1 \
      && echo "$(date '+%F %T'): действие средней кнопки восстановлено"
fi
