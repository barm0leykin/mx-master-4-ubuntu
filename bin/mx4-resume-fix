#!/bin/bash
# Восстановление после suspend:
#  - слушатель Solaar умирает на disconnect мыши при засыпании;
#  - мышь сбрасывает divert-режимы (та же флора, что и сброс трещотки);
#  - Kando обычно выживает, но подстрахуемся.
# Вызывается user-юнитом mx4-resume.service (запускается хуком
# /usr/lib/systemd/system-sleep/mx4-resume.hook после suspend).
LOG=/tmp/mx4-resume.log
echo "$(date '+%F %T'): resume-fix старт" >> "$LOG"
sleep 5  # дать Bluetooth переподключиться

pkill -f "venvs/solaar/bin" 2>/dev/null || true  # страховка от дубля от автозапуска
sleep 1
systemctl --user restart solaar.service
sleep 6

# Divert-режимы: Solaar сам пере-применяет config.yaml при подключении;
# если нет — применяем вручную.
CUR=$(timeout 10 "$HOME/.local/bin/solaar" config "MX Master 4" divert-keys 2>/dev/null | tail -1)
if ! echo "$CUR" | grep -q "Перенаправлено"; then
    timeout 10 "$HOME/.local/bin/solaar" config "MX Master 4" divert-keys "Mouse Gesture Button" "Жесты мышью" >>"$LOG" 2>&1
    timeout 10 "$HOME/.local/bin/solaar" config "MX Master 4" divert-keys "Haptic" "Жесты мышью" >>"$LOG" 2>&1
    echo "$(date '+%F %T'): divert-режимы пере-применены" >> "$LOG"
fi

if ! pgrep -x kando >/dev/null; then
    setsid "$HOME/.local/bin/kando" >/tmp/kando.log 2>&1 &
    echo "$(date '+%F %T'): Kando перезапущен" >> "$LOG"
fi
echo "$(date '+%F %T'): resume-fix готов" >> "$LOG"
