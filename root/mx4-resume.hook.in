#!/bin/sh
# После suspend: восстановить привязки MX Master 4 (Solaar/Kando) в сессии __USER__
if [ "$1" = "post" ] && [ "$2" = "suspend" ]; then
    sleep 2
    su __USER__ -c 'XDG_RUNTIME_DIR=/run/user/__UID__ DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/__UID__/bus systemctl --user start mx4-resume.service' || true
fi
